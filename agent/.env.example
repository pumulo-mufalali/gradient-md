# GradientMD Agent Environment Variables
# Copy this to .env and fill in your values

# DigitalOcean API Token (for deploying agents)
DIGITALOCEAN_API_TOKEN=your_digitalocean_api_token_here

# Gradient AI Model Access Key (for serverless inference)
GRADIENT_MODEL_ACCESS_KEY=your_model_access_key_here

# Optional: Fine-tuned model endpoint (GPU Droplet with vLLM)
FINE_TUNED_MODEL_URL=http://your-gpu-droplet-ip:8000/v1

# Optional: OpenFDA API key for drug interaction lookups
OPENFDA_API_KEY=your_openfda_api_key_here
