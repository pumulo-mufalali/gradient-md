# GradientMD Frontend Environment Variables
# Copy this to .env.local and fill in your values

# DigitalOcean Gradient AI Agent Endpoint
# This is the deployment URL from `gradient agent deploy`
AGENT_ENDPOINT=https://agents.do-ai.run/v1/YOUR_WORKSPACE_ID/production/run

# DigitalOcean API Token (for authenticating agent requests)
DIGITALOCEAN_API_TOKEN=your_digitalocean_api_token_here

# Optional: Serverless Inference Model Access Key
GRADIENT_MODEL_ACCESS_KEY=your_model_access_key_here
