# GradientMD Frontend Environment Variables
# Copy this to .env.local and fill in your values

# DigitalOcean Agent Endpoint
# This will be provided after deploying the agent with: doctl serverless deploy agent/
AGENT_ENDPOINT=https://your-agent-endpoint.do-ai.run

# DigitalOcean API Token (for authenticating with the agent)
DIGITALOCEAN_API_TOKEN=your_digitalocean_api_token_here

# Optional: For local development, you can use a mock endpoint
# AGENT_ENDPOINT=http://localhost:8000
